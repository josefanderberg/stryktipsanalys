rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tre separata databaser: en per spelform + NILLE:s personliga.
    // Öppna för läs/skriv utan inloggning (prototyp) – allt annat förblir låst.
    match /stryktipset/{id} {
      allow read, write: if true;
    }
    match /europatipset/{id} {
      allow read, write: if true;
    }
    match /nille/{id} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
