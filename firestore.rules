rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Prototypen sparar omgångar här. Öppet för läs/skriv utan inloggning –
    // begränsat till just denna samling. Övriga samlingar förblir låsta.
    match /omgangar/{id} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
